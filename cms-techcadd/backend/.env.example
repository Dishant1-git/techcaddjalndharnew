# Copy to .env and fill in. The API validates all of this at boot and exits
# with a clear message rather than failing on the first request.

NODE_ENV=development
PORT=4000

# Where the CMS runs. Comma-separated, because Vite falls back to 5174/5175
# when 5173 is taken and the browser would otherwise block every request.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote it. A '#' outside quotes starts a comment, which silently truncates
# the password and produces a confusing access-denied error.
DB_PASSWORD="change-me"
DB_NAME=techcadd_cms

# --- sessions ---------------------------------------------------------------
# At least 16 characters. Changing it signs everyone out.
COOKIE_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7

# Sign-in attempts per IP per 15 minutes. Unset means 10 in production and
# 200 in development, where the only thing it throttles is you.
# LOGIN_ATTEMPTS_PER_15_MIN=10

# --- uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- email (optional) -------------------------------------------------------
# Without SMTP_HOST the CMS still runs and mail is logged to the console
# instead of sent, so password reset can be tested without a mail server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=TechCADD CMS <no-reply@techcadd.com>
