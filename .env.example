# Template only — no real values here, this file is committed.
# Copy to .env.local and fill it in. .env.local is git-ignored.

# --- MySQL (lib/db.ts) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=techcaddjal

# Connections held open by the pool. 10 is plenty for a marketing site.
DB_POOL_SIZE=10

# true when the host requires TLS (PlanetScale, Aiven, Azure Database).
DB_SSL=false

# false when the database user cannot CREATE TABLE — apply db/schema.sql yourself.
DB_AUTO_MIGRATE=true

# --- Enquiry form captcha (lib/captcha.ts) ---
