# Template. Copy to .env.local and fill in real values there.
#
# This file IS committed to the repository, so every value below is a
# placeholder — a real password or secret written here is published the moment
# the repo is pushed. .env.local is git-ignored (.gitignore:8) and is the only
# place real values belong.

# --- MySQL (lib/db.ts) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=TechcaddJal

# Connections held open by the pool. 10 is plenty for a marketing site.
DB_POOL_SIZE=10

# true when the host requires TLS (PlanetScale, Aiven, Azure Database).
DB_SSL=false

# false when the database user cannot CREATE TABLE — apply db/schema.sql yourself.
DB_AUTO_MIGRATE=true

# --- CMS (lib/cms.ts, middleware.ts, next.config.mjs) ---
# Where cms-techcadd/backend is listening, including the /api prefix.
CMS_API_URL=http://localhost:4000/api

# 0 in development so an edit in the CMS shows on the next reload. Unset in
# production it defaults to 300 seconds.
CMS_CACHE_SECONDS=0

# A slow CMS degrades a page to its built-in content rather than hanging it.
CMS_TIMEOUT_MS=4000

# Lets the CMS drop this site's cached content the moment something is
# published. Must match REVALIDATE_SECRET in cms-techcadd/backend/.env — if the
# two differ the ping is rejected and changes wait out CMS_CACHE_SECONDS.
REVALIDATE_SECRET=generate-a-long-random-string

# --- Enquiry form captcha (lib/captcha.ts) ---
# At least 32 random characters. Production refuses a shorter one and
# GET /api/captcha then 500s, which every form reports to the visitor as
# "The security check could not be loaded."
# Generate one with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
CAPTCHA_SECRET=generate-at-least-32-random-characters

# --- /admin dashboard (lib/admin-auth.ts) ---
# The sign-in for http://localhost:3000/admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Signs the session cookie. Changing this — or the password above — signs
# everyone out.
ADMIN_SESSION_SECRET=generate-a-long-random-string
