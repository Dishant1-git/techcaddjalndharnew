# Template only — no real values here, this file is committed.
# Copy to .env.local and fill it in. .env.local is git-ignored.
#
# Anything that has ever been committed to a repository is public forever.
# If a real password or secret was pasted into this file at any point, rotate
# it rather than editing it out.

# --- MySQL (lib/db.ts) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=replace-me

# Connections held open by the pool. 10 is plenty for a marketing site.
DB_POOL_SIZE=10

# true when the host requires TLS (PlanetScale, Aiven, Azure Database).
# Turn it on for any database reached over a network you do not own.
DB_SSL=false

# false when the database user cannot CREATE TABLE — apply db/schema.sql yourself.
# Set it to false in production and give the app user only SELECT, INSERT and
# DELETE: a runtime that cannot run DDL cannot be made to drop your tables.
DB_AUTO_MIGRATE=true

# --- Enquiry form captcha: Google reCAPTCHA v2 (lib/recaptcha.ts) ---
# Both REQUIRED in production — the forms have no other anti-bot control, and
# the API refuses every submission if the secret is missing.
#
# Get a pair at https://www.google.com/recaptcha/admin — choose "reCAPTCHA v2"
# then "I'm not a robot Checkbox", and list every domain the site runs on,
# including localhost for development.
#
# The site key is public: it is compiled into the page and visible in the
# source, which is why it carries the NEXT_PUBLIC_ prefix. The secret key must
# never reach the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Legacy arithmetic captcha (lib/captcha.ts) ---
# No longer used by /api/enquiry, which now verifies with reCAPTCHA above.
# lib/captcha.ts, lib/spent-captchas.ts and /api/captcha are still present but
# unreferenced — delete them, or set this to bring the old challenge back.
CAPTCHA_SECRET=

# --- Request attribution (lib/request-guard.ts) ---
# How many proxies in front of this app APPEND to X-Forwarded-For.
#   0 = the app is exposed directly, so the header is ignored entirely
#   1 = one Nginx / cPanel / Cloudflare hop (default)
# Too high and a client can forge the address the rate limiter counts against.
TRUSTED_PROXY_HOPS=1

# Set only if your proxy OVERWRITES a header with the real client address
# (cf-connecting-ip behind Cloudflare). Takes priority over the hop count.
# Leave blank when the proxy merely appends, or clients can forge it.
CLIENT_IP_HEADER=

# Extra origins allowed to POST to /api (comma separated), for a staging or
# preview domain. The site's own host is always allowed.
ALLOWED_ORIGINS=
