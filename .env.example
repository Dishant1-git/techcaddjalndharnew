# Local development settings. Git-ignored — never commit this file.

# --- MySQL (lib/db.ts) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=TechcaddJal

# Connections held open by the pool. 10 is plenty for a marketing site.
DB_POOL_SIZE=10

# true when the host requires TLS (PlanetScale, Aiven, Azure Database).
DB_SSL=false

# false when the database user cannot CREATE TABLE — apply db/schema.sql yourself.
DB_AUTO_MIGRATE=true

# --- CMS (lib/cms.ts, middleware.ts, next.config.mjs) ---
# Where cms-techcadd/backend is listening, including the /api prefix.
CMS_API_URL=http://localhost:4000/api

# 0 in development so an edit in the CMS shows on the next reload. Unset in
# production it defaults to 300 seconds.
CMS_CACHE_SECONDS=0

# A slow CMS degrades a page to its built-in content rather than hanging it.
CMS_TIMEOUT_MS=4000

# Lets the CMS drop this site's cached content the moment something is
# published. Must match REVALIDATE_SECRET in cms-techcadd/backend/.env — if the
# two differ the ping is rejected and changes wait out CMS_CACHE_SECONDS.
REVALIDATE_SECRET=XfXGss4xqchW_RhbhepLhU0mkUXL-Rvw0Pg0HwslsNpGHjY3

# --- Enquiry form captcha (lib/captcha.ts) ---
# Any long random string. Rotating it invalidates in-flight captchas only.
CAPTCHA_SECRET=qwsaxdeasx

# --- Google reCAPTCHA v2 ---
# Get a pair at https://www.google.com/recaptcha/admin
#   type: reCAPTCHA v2  ->  "I'm not a robot" Checkbox
#   domains: your live domain AND localhost (for development)
# Restart `npm run dev` after changing these — NEXT_PUBLIC_ values are compiled
# into the bundle, so a running dev server will not pick them up.
#
# These belong HERE and only here. .env.example is committed to the repository,
# so a real key placed there is published the moment the repo is pushed.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfBWIUtAAAAAHfCEq8vhiV6BNfraE6ORei_YAny
RECAPTCHA_SECRET_KEY=6LfBWIUtAAAAAKM9iawNpp30JCTgsTg5PQe30IIK

# --- /admin dashboard (lib/admin-auth.ts) ---
# The predefined sign-in for http://localhost:3000/admin.
# These belong HERE and only here — .env.example is committed, so a real
# password placed there is published the moment the repo is pushed.
ADMIN_USERNAME=techcadd
ADMIN_PASSWORD=techcadd@123

# Signs the session cookie. Changing this — or the password above — signs
# everyone out.
ADMIN_SESSION_SECRET=zoF2gi6clgjUJ7-PgqiALIF4awvCFRQ5lanyUnKQEPmov98EKvPmNppnLs9UxVDE

# Google's official TEST keys. Uncomment to see the widget working locally
# without registering anything. WARNING: they accept EVERY submission and show
# a "for testing purposes only" banner. Never deploy with these.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
