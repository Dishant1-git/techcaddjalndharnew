# Values for docker-compose.yml — the whole stack (website + CMS API + CMS
# admin + MySQL) reads these. In Coolify, you enter these in the Coolify
# resource's Environment Variables tab, NOT as a file. This file is only
# useful for testing the stack locally: copy it to ".env" next to
# docker-compose.yml, fill in real values, then run `docker compose up --build`.
#
# Never commit a real ".env" file — only this ".example" one is meant to be
# in git.

# Your domain, no https://, no subdomain. Everything else is built from it:
# website -> APP_DOMAIN, CMS API -> cms-api.APP_DOMAIN, CMS admin -> cms.APP_DOMAIN
APP_DOMAIN=techcaddjalandhar.com

# --- MySQL ---
MYSQL_ROOT_PASSWORD=choose-a-strong-root-password
CMS_DB_PASSWORD=choose-a-strong-password-for-the-cms-db-user
SITE_DB_PASSWORD=choose-a-different-strong-password-for-the-site-db-user

# --- Shared between the CMS API and the website — must match exactly ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=generate-a-long-random-string

# --- CMS API only ---
# Generate: node -e "console.log(require('crypto').randomUUID() + require('crypto').randomUUID())"
COOKIE_SECRET=generate-a-long-random-string-at-least-16-chars

# --- Website only ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CAPTCHA_SECRET=generate-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=generate-a-long-random-string
